# Render sets PORT itself; the server listens on 0.0.0.0. A deployed server also sets NODE_ENV=production.
PORT=3001

# Active AI provider
AI_PROVIDER=cloudflare

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Gemini alternate (selected only when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# AI request timeout
AI_TIMEOUT_MS=120000

# Set to the exact browser origin. On Render it defaults to the service's own address (RENDER_EXTERNAL_URL, which
# Render sets), e.g. https://<name>.onrender.com; set it only to pin that address or for a custom domain.
CLIENT_ORIGIN=http://localhost:5173

# Render has one trusted proxy hop.
# Keep 0 for direct local access; set 1 on Render.
TRUST_PROXY_HOPS=0

# Optional persistent data folder, e.g. /var/data/frameflow on a paid Render disk mounted at /var/data. Templates,
# uploads, creatives, runs and Template Studio data go to <it>/artifacts/ (the same layout as the repository's
# artifacts/ folder). Unset, or naming a disk that is not there (Render Free has none), the repository's own folders are
# used, with a startup warning on a host where they are temporary.
FRAMEFLOW_DATA_DIR=

# Shared password of a deployed server (HTTP Basic: the browser asks once; /api/health stays open). Set it before adding
# paid AI keys to a public deployment: a production server with OPENAI_API_KEY, FAL_KEY, GEMINI_API_KEY or
# CLOUDFLARE_API_TOKEN and no password refuses every API change. Leave empty locally.
FRAMEFLOW_ACCESS_PASSWORD=
# FRAMEFLOW_ACCESS_USER=frameflow

# Decomposition uses only fal.ai; existing image tools keep their current provider.
DECOMPOSITION_ENABLED=false
FAL_KEY=
# Relative paths resolve from the server directory in API and worker. Default ./data/decomposition, or
# FRAMEFLOW_DATA_DIR/data/decomposition when that is set.
# DECOMP_DATA_DIR=./data/decomposition
DECOMP_AUTH_MODE=local-operator
# Generate securely with npm run decomp:setup; never paste credentials into chat.
DECOMP_OPERATOR_PASSWORD_HASH=
DECOMP_ANALYSIS_MAX_SIDE=1024
DECOMP_MAX_OBJECTS=6
DECOMP_MAX_HIDDEN_OBJECTS=2
DECOMP_JOB_CONCURRENCY=1
DECOMP_MODEL_CONCURRENCY=2
DECOMP_MAX_CALLS_PER_JOB=20
DECOMP_PHASE_TIMEOUT_MS=300000
DECOMP_JOB_TIMEOUT_MS=1200000
DECOMP_ARTIFACT_RETENTION_DAYS=7
DECOMP_ALLOW_ERASE_FALLBACK=true
DECOMP_ENABLE_WEBHOOKS=false

# Explicit development demo; live is the default. Mock accepts only the owned fixture.
DECOMP_PROVIDER_MODE=live

# Layerize experiment (the Template A/B/C review flow): LAYERIZE_EXPERIMENT=1 serves /api/layerize-experiment, in
# development and in production. Unset = not mounted. It has no login: behind a proxy it only answers requests from
# CLIENT_ORIGIN, which keeps other sites out but does not stop a visitor of the app from spending credit.
# OpenAI plans the decomposition and generates the templates' test source images; fal (FAL_KEY above) runs Seedream Layerize.
# Model defaults live in server/src/decomposition/aiModels.ts; set these only to override them.
LAYERIZE_EXPERIMENT=
# Template B test generator: the first ratio is generated from text, the others from that image (OpenAI image edit).
# off = every ratio from its prompt alone, as Templates A and C do.
TEMPLATE_RATIO_REFERENCE=
OPENAI_API_KEY=
# OPENAI_DECOMPOSITION_MODEL=
# OPENAI_IMAGE_MODEL=
# Creative templates: smart edits (the uploaded image analyzed, edits resolved into a change plan) and "Generate
# creative template" (new scenes around the image's own subjects). Both are on with LAYERIZE_EXPERIMENT=1 and report
# themselves unavailable when a key is missing. Every call is an explicit user action; nothing is retried automatically.
# CREATIVE_SMART_EDIT=0          turns smart edits off (the saved template fields remain)
# CREATIVE_VARIANTS=0            turns Generate creative template off
# CREATIVE_SEMANTIC_VERIFY=0     turns the AI check of generated results off (results are then shown as not checked)
# CREATIVE_CUTOUT_PROVIDER=sam3  subject masks: sam3 (fal, default), birefnet (fal), or none (the user uploads a cutout)
# OPENAI_SCENE_MODEL=            image analysis (default gpt-5.6-sol); the next three default to it
# OPENAI_RESOLVER_MODEL=
# OPENAI_VERIFIER_MODEL=
# OPENAI_CONCEPT_MODEL=

# Template Studio (served with LAYERIZE_EXPERIMENT=1). Overrides only; defaults live in server/src/templateStudio/config.ts.
# STUDIO_ANALYSIS_MODEL=
# STUDIO_PLANNER_MODEL=
# STUDIO_REVIEW_MODEL=
# STUDIO_IMAGE_MODEL=
# STUDIO_TEXT_REASONING_EFFORT=low       none | low | medium | high
# STUDIO_IMAGE_QUALITY=high              low | medium | high
# STUDIO_MAX_JOB_BUDGET_USD=1
# STUDIO_MAX_TEMPLATE_BUDGET_USD=1
# STUDIO_DAILY_BUDGET_USD=5
# Where Template Studio keeps its templates, assets and cost ledger (default artifacts/template-studio, under
# FRAMEFLOW_DATA_DIR when that is set, else in the repository). Set it only to keep them somewhere else.
# TEMPLATE_STUDIO_DIR=
# Rupees per US dollar shown beside AI cost estimates.
# AI_BUDGET_USD_INR=

# Offer and product templates, Reuse Template / Create Offer Creative and their decomposition (also LAYERIZE_EXPERIMENT=1).
# Their files (templates, uploads, creatives, runs) are kept under artifacts/decomposition/: in FRAMEFLOW_DATA_DIR when
# that is set (required in production, or every deploy starts empty), else in the repository.
# FRAMEFLOW_PRODUCT_IMAGE_CONCURRENCY=2  image requests in flight at once (1–4)
# OPENAI_STRUCTURE_CHEAP_MODEL=
# OPENAI_STRUCTURE_STRONG_MODEL=
# OPENAI_THEME_MODEL=
# SMART_EDIT_CANVAS=                     fixed = the three fixed generation sizes instead of the source's own ratio
# DECOMP_DISCOVERY_PROVIDER=seedream     seedream | qwen
# DECOMP_DISCOVERY_FALLBACK=qwen         qwen | none
# DECOMP_TRUSTED_MEDIA_HOSTS=fal.media,*.fal.media
