PORT=3001

# Active AI provider
AI_PROVIDER=cloudflare

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Gemini alternate (selected only when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# AI request timeout
AI_TIMEOUT_MS=120000

# Set to the exact browser origin; production uses the same-origin Render URL.
CLIENT_ORIGIN=http://localhost:5173

# Render has one trusted proxy hop.
# Keep 0 for direct local access; set 1 on Render.
TRUST_PROXY_HOPS=0

# Decomposition uses only fal.ai; existing image tools keep their current provider.
DECOMPOSITION_ENABLED=false
FAL_KEY=
# Relative paths resolve from the server directory in API and worker.
DECOMP_DATA_DIR=./data/decomposition
DECOMP_AUTH_MODE=local-operator
# Generate securely with npm run decomp:setup; never paste credentials into chat.
DECOMP_OPERATOR_PASSWORD_HASH=
DECOMP_ANALYSIS_MAX_SIDE=1024
DECOMP_MAX_OBJECTS=6
DECOMP_MAX_HIDDEN_OBJECTS=2
DECOMP_JOB_CONCURRENCY=1
DECOMP_MODEL_CONCURRENCY=2
DECOMP_MAX_CALLS_PER_JOB=20
DECOMP_PHASE_TIMEOUT_MS=300000
DECOMP_JOB_TIMEOUT_MS=1200000
DECOMP_ARTIFACT_RETENTION_DAYS=7
DECOMP_ALLOW_ERASE_FALLBACK=true
DECOMP_ENABLE_WEBHOOKS=false

# Explicit development demo; live is the default. Mock accepts only the owned fixture.
DECOMP_PROVIDER_MODE=live

# Layerize experiment (the Template A/B/C review flow): LAYERIZE_EXPERIMENT=1 serves /api/layerize-experiment, in
# development and in production. Unset = not mounted. It has no login: behind a proxy it only answers requests from
# CLIENT_ORIGIN, which keeps other sites out but does not stop a visitor of the app from spending credit.
# OpenAI plans the decomposition and generates the templates' test source images; fal (FAL_KEY above) runs Seedream Layerize.
# Model defaults live in server/src/decomposition/aiModels.ts; set these only to override them.
LAYERIZE_EXPERIMENT=
# Template B test generator: the first ratio is generated from text, the others from that image (OpenAI image edit).
# off = every ratio from its prompt alone, as Templates A and C do.
TEMPLATE_RATIO_REFERENCE=
OPENAI_API_KEY=
# OPENAI_DECOMPOSITION_MODEL=
# OPENAI_IMAGE_MODEL=
