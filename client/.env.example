# Local development uses Vite's /api proxy. For Vercel, set the Render API URL:
# VITE_API_BASE_URL=https://your-render-service.onrender.com/api
VITE_API_BASE_URL=/api

# The earlier generic "Image to layers" decomposition flow: its floating button, the AI panel's "Decompose" operation
# and the editor's "Detected layers" tray. Hidden unless this is 1. The template flow (OpenAI + Seedream test,
# Templates A/B/C) does not depend on it. `npm run dev:decomposition` turns it on for that session.
VITE_LEGACY_IMAGE_TO_LAYERS=
